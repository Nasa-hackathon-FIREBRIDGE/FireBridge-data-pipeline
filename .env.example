# Run python3 scripts/init_local.py to create .env with generated passwords.
# For Airflow/dbt use python3 scripts/init_server.py (adds private deployment keys).
# init_local creates random local DB passwords; never commit .env.
FIREBRIDGE_DB_PASSWORD=replace-with-random-password
FIREBRIDGE_READER_PASSWORD=replace-with-another-random-password
DATABASE_URL=postgresql://firebridge:replace-with-random-password@localhost:55432/firebridge
FIREBRIDGE_DATA_DIR=./data/platform
# Free FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# This is different from a NASA Earthdata token.
FIRMS_MAP_KEY=
# Only needed for protected NASA science-file downloads, not FIRMS CSVs.
EARTHDATA_TOKEN=
# Conservative shared FIRMS budget; includes availability calls.
FIREBRIDGE_FIRMS_REQUESTS_PER_10_MIN=60
FIREBRIDGE_MAX_DOWNLOAD_MB=256
FIREBRIDGE_POLL_SECONDS=30
# Explicit publisher host allowlist for optional RSS/Atom polling (empty = disabled).
FIREBRIDGE_NEWS_ALLOWED_HOSTS=
